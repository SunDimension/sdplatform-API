models:
    ItemCategory: { id: 'uuid primary', name: string }
    ItemType: { id: 'uuid primary', name: string }
    Unit: { id: 'uuid primary', name: string }
    Dimension: { id: 'uuid primary', name: string }
    Weight: { id: 'uuid primary', name: string }
    ExpenseAccount: { id: 'uuid primary', name: string }
    AdjustmentType: { id: 'uuid primary', name: string }
    Status: { id: 'uuid primary', name: string }
    CustomerType: { id: 'uuid primary', name: string }
    Branch: { id: 'uuid primary', name: string, address: string, contact_person: string, email: string, phone: string, state_id: 'id foreign:states', country_id: 'id foreign:countries' }
    Title: { id: 'uuid primary', name: string }
    Warehouse: { id: 'uuid primary', name: string, branch_id: 'id foreign:branches', warehouse_address: string, zipcode: string, contact_person: string, email: string, phone: string }
    PaymentTerm: { id: 'uuid primary', name: string }
    Tax: { id: 'uuid primary', name: string }
    Discount: { id: 'uuid primary', name: string }
    PaymentMode: { id: 'uuid primary', name: string }
    Carrier: { id: 'uuid primary', name: string }
    PaymentType: { id: 'uuid primary', name: string }
    Designation: { id: 'uuid primary', name: string }
    Bank: { id: 'uuid primary', name: string }
    Manufacturer: { id: 'uuid primary', name: string }
    VendorType: { id: 'uuid primary', name: string }
    Reason: { id: 'uuid primary', name: string }
    Brand: { id: 'uuid primary', name: string }
    Attribute: { id: 'uuid primary', name: string }
    Country: { id: 'uuid primary', name: string }
    State: { id: 'uuid primary', name: string }
    CreateItem: { id: 'uuid primary', name: string, item_category_id: 'id foreign:item_categories', item_type_id: 'id foriegn:item_types', description: string, batch_number: string, unit_id: 'id foreign:units', brand_id: 'id foreign:brands', cost_price: float, selling_price: float, reorder_level: string, dimension_id: 'id foreign:dimensions', weight_id: 'id foreign:weights', branch_id: 'id foreign:branches', warehouse: 'id foreign:warehouses', vendor_id: 'id foreign:vendors', image_url: string, barcode: string }
    Vendor: { id: 'uuid primary', name: string, address: string, contact_title: string, contact_designation: string, contact_surname: string, contact_firstname: string, contact_middlename: string, contact_fullname: string, vendor_type_id: 'id foreign:vendor_types', phone_number: string, email: string, image_url: string, tin: string, bank_id: 'id foriegn:banks', account_number: string }
    TransferOrder: { id: 'uuid primary', transfer_order_number: string, transfer_date: timestamp, transfer_reason: string, source_warehouse_id: 'id foreign:warehouses', destination_warehouse_id: 'id foreign:warehouses', image_url: string, transfer_quantity: string, item_id: 'id foreign:create_items' }
    Delivery: { id: 'uuid primary', customer_id: 'id foreign:customers', sales_order_number: string, delivery_order_number: string, delivery_date: timestamp, carrier_id: 'id foreign:carriers', notes: string }
    InventoryAdjustment: { id: 'uuid primary', item_id: 'id foreign:create_items', adjustment_type_id: 'id foreign:adjustment_types', date: timestamp, reason_id: 'id foreign:reasons', branch_id: 'id foreign:branchs', warehouse_id: 'id foreign:warehouses', description: string, item_category_id: 'id foreign:item_categories', cost_price: float, selling_price: float, quantity: string }
    Invoice: { id: 'uuid primary', branch_id: 'id foriegn:branches', warehouse_id: 'id foreign:warehouses', customer_id: 'id foreign:customerss', invoice_number: string, order_number: string, invoice_date: timestamp, item_id: 'id foreign:create_items', rate: string, quantity: string, discount_id: 'id foreign:discounts', tax_id: 'id foreign:taxes', amount: string }
    Sale: { id: 'uuid primary', customer_id: 'id foreign:customerss', product_id: 'id foreign:create_items', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', quantity: float, price: float, discount_id: 'id foreign:discounts', discount: float, sales_order_number: string, total_amount: flaot, amount_paid: float, balance_amount: float, payment_mode: 'id foreign:payment_modes' }
    CreditLimit: { id: 'uuid primary', name: string }
    CreditSale: { id: 'uuid primary', customer_id: 'id foreign:customerss', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', product_id: 'id foreign:create_items', credit_limit: 'id foreign:credit_limits', credit_amount: string, credit_balance: string }
    Customer: { id: 'uuid primary', customer_type_id: 'id foreign:customer_types', title_id: 'id foreign:titles', surname: string, firstname: string, middlename: string, phone_number: string, fullname: string }
    PaymentReceived: { id: 'uuid primary', customer_id: 'id foreign:customers', amount_received: string, bank_charges: float, payment_number: string, deposit_bank_id: 'id foreign:banks', payment_mode_id: 'id foreign:payment_modes', invoice_number: string }
    SalesReceipt: { id: 'uuid primary', customer_id: 'id foreign:customers', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', product_id: 'id foreign:create_items', tax_id: 'id foreign:taxes', payment_mode_id: 'id foreign:payment_modes', discount_id: 'id foreign:discounts', quantity: string, rate: string, amount: string, receipt_date: timestamp, customer_note: string }
    PaymentVoucher: { id: 'uuid primary', product_id: 'id foreign:create_items', expense_date: timestamp, amount: string, description: string, branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', tax_id: 'id foreign:taxes', vendor_id: 'id foreign:vendors', payment_mode_id: 'id foreign:payment_modes', expense_account_id: string }
    VendorCredit: { id: 'uuid primary', vendor_id: 'id foreign:vendors', warehouse_id: 'id foreign:warehouses', credit_number: string, purchase_order_number: string, vendor_credit_date: date }
    PurchaseReceivedDetail: { id: 'uuid primary', new_purchased_received_id: 'id foreign:new_purchase_receiveds', item_category_id: 'id foreign:item_categories', item_id: 'id foreign:create_items', unit_price: string, quantity: string, unit_id: 'id foreign:units' }
    Role: { id: 'uuid primary', name: string, description: string }
    User: { id: 'uuid primary', role_id: 'id foreign:role', user_name: string, user_email: string, password: string, status_id: 'id foreign:statuses' }
    NewPurchaseOrder: { id: 'uuid primary', item_category_id: 'id foreign:item_categories', item_id: 'id foreign:create_items', vendor_id: 'id foreign:vendors', branch_id: 'id foreign:branches', payment_mode_id: 'id foreign:payment_modes', purchase_order_number: string, purchase_amount: string, purchase_date: timestamp, expected_delivery_date: date, payment_type_id: 'id foreign:payment_types' }
    NewPurchaseReceived: { id: 'uuid primary', vendor_id: 'id foreign:vendors', purchase_order_number: string, purchase_received_number: string, received_date: date }
    NewPayment: { id: 'uuid primary', vendor_id: 'id foreign:vendors', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', payment_amount: string, payment_mode_id: 'id foreign:payment_modes', description: string }
    PaymentVoucherDetail: { id: 'uuid primary', Expense_account_id: int, amount: string, quantity: string, item_id: 'id foreign:create_items' }
    PurchaseOrderDetail: { item_category_id: 'id foreign:item_categories', purchase_order_id: int, item_id: 'id foreign:create_items', unit_price: string, quantity: string, unit_id: 'id foreign:units' }
