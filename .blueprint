    PropertyEnquiry: { id: 'uuid primary', property_id: 'uuid foreign:properties', sender_id: 'uuid foreign:users', receiver_id: 'uuid foreign:users', message: text, status: string, email: 'string nullable', phone: 'string nullable', timestamps: {  } }
    PropertyView: { id: 'uuid primary', property_id: 'uuid foreign:properties', user_id: 'uuid foreign:users nullable', ip_address: 'string nullable', device: 'string nullable', browser: 'string nullable', country: 'string nullable', viewed_at: timestamp, timestamps: {  } }
    SavedProperty: { id: 'uuid primary', property_id: 'uuid foreign:properties', user_id: 'uuid foreign:users', timestamps: {  } }
