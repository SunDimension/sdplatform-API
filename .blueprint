models:
    User: { id: 'uuid primary', role_id: 'uuid foreign:roles', agency_id: 'uuid foreign:agencies nullable', firstname: string, lastname: string, password: string, profile_picture: 'string nullable', date_of_birth: 'date nullable', gender: 'string nullable', email: 'string unique', phone: 'string nullable', status: string, email_verified: 'boolean default:false', phone_verified: 'boolean default:false', kyc_verified: 'boolean default:false', last_login: 'timestamp nullable', remember_token: 'string nullable', timestamps: {  } }
    Agency: { id: 'uuid primary', company_name: string, registeration_number: string, address: string, phone: string, email: string, status: string, website: 'string nullable', license_number: 'string nullable', logo: 'string nullable', description: 'text nullable', subscription_id: 'uuid foreign:subscriptions nullable', timestamps: {  } }
    Property: { id: 'uuid primary', agency_id: 'uuid foreign:agencies nullable', owner_id: 'uuid foreign:users', agent_id: 'uuid foreign:users nullable', property_type_id: 'uuid foreign:property_types', category_id: 'uuid foreign:property_categories', status_id: 'uuid foreign:property_statuses', purpose: string, description: text, price: float, title: string, currency: string, negotiable: 'boolean default:false', bedrooms: 'integer nullable', bathrooms: 'integer nullable', toilets: 'integer nullable', parking_spaces: 'integer nullable', kitchen: 'integer nullable', living_rooms: 'integer nullable', land_size: 'float nullable', building_size: 'float nullable', year_built: 'integer nullable', floors: 'integer nullable', furnished: 'boolean default:false', serviced: 'boolean default:false', pet_friendly: 'boolean default:false', minimum_rent_period: 'string nullable', available_from: 'date nullable', longitude: 'float nullable', latitude: 'float nullable', country_id: 'uuid foreign:countries', state_id: 'uuid foreign:states', city_id: 'uuid foreign:cities', area_id: 'uuid foreign:areas nullable', street_address: 'string nullable', postal_code: 'string nullable', featured: 'boolean default:false', premium: 'boolean default:false', verified: 'boolean default:false', views: 'integer default:0', likes: 'integer default:0', published_at: 'timestamp nullable', expiry_date: 'timestamp nullable', timestamps: {  } }
    Role: { id: 'uuid primary', name: string, timestamps: {  } }
    Permission: { id: 'uuid primary', name: string, timestamps: {  } }
    PermissionRole: { id: 'uuid primary', permission_id: 'uuid foreign:permissions', role_id: 'uuid foreign:roles', timestamps: {  } }
    PropertyType: { id: 'uuid primary', name: string, timestamps: {  } }
    PropertyCategory: { id: 'uuid primary', name: string, timestamps: {  } }
    PropertyStatus: { id: 'uuid primary', name: string, timestamps: {  } }
    PropertyImage: { id: 'uuid primary', property_id: 'uuid foreign:properties', image_url: string, is_cover: 'boolean default:false', timestamps: {  } }
    PropertyVideo: { id: 'uuid primary', property_id: 'uuid foreign:properties', video_url: string, thumbnail: 'string nullable', timestamps: {  } }
    PropertyDocument: { id: 'uuid primary', property_id: 'uuid foreign:properties', survey_plan_url: 'string nullable', title: string, CofO: 'string nullable', floor_plan: 'string nullable', approval_letter: 'string nullable', document_type: string, verified: 'boolean default:false', document_url: string, timestamps: {  } }
    Feature: { id: 'uuid primary', name: string, timestamps: {  } }
