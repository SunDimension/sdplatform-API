models:
    ItemCategory: { name: string }
    ItemType: { name: string }
    Unit: { name: string }
    Dimension: { name: string }
    Weight: { name: string }
    ExpenseAccount: { name: string }
    AdjustmentType: { name: string }
    Status: { name: string }
    CustomerType: { name: string }
    Branch: { name: string, address: string, contact_person: string, email: string, phone: string, state_id: 'id foreign:states', country_id: 'id foreign:countries' }
    Title: { name: string }
    Warehouse: { name: string, branch_id: 'id foreign:branches', warehouse_address: string, zipcode: string, contact_person: string, email: string, phone: string }
    PaymentTerm: { name: string }
    Tax: { name: string }
    Discount: { name: string }
    PaymentMode: { name: string }
    Carrier: { name: string }
    PaymentType: { name: string }
    Designation: { name: string }
    Bank: { name: string }
    Manufacturer: { name: string }
    VendorType: { name: string }
    Reason: { name: string }
    Brand: { name: string }
    Attribute: { name: string }
    Country: { name: string }
    State: { name: string }
    CreateItem: { name: string, item_category_id: 'id foreign:item_categories', item_type_id: 'id foriegn:item_types', description: string, batch_number: string, unit_id: 'id foreign:units', brand_id: 'id foreign:brands', cost_price: float, selling_price: float, reorder_level: string, dimension_id: 'id foreign:dimensions', weight_id: 'id foreign:weights', branch_id: 'id foreign:branches', warehouse: 'id foreign:warehouses', vendor_id: 'id foreign:vendors', image_url: string, barcode: string }
    Vendor: { name: string, address: string, contact_title: string, contact_designation: string, contact_surname: string, contact_firstname: string, contact_middlename: string, contact_fullname: string, vendor_type_id: 'id foreign:vendor_types', phone_number: string, email: string, image_url: string, tin: string, bank_id: 'id foriegn:banks', account_number: string }
    TransferOrder: { transfer_order_number: string, transfer_date: timestamp, transfer_reason: string, source_warehouse_id: 'id foreign:warehouses', destination_warehouse_id: 'id foreign:warehouses', image_url: string, transfer_quantity: string, item_id: 'id foreign:create_items' }
    Delivery: { customer_id: 'id foreign:customers', sales_order_number: string, delivery_order_number: string, delivery_date: timestamp, carrier_id: 'id foreign:carriers', notes: string }
    InventoryAdjustment: { item_id: 'id foreign:create_items', adjustment_type_id: 'id foreign:adjustment_types', date: timestamp, reason_id: 'id foreign:reasons', branch_id: 'id foreign:branchs', warehouse_id: 'id foreign:warehouses', description: string, item_category_id: 'id foreign:item_categories', cost_price: float, selling_price: float, quantity: string }
    Invoice: { branch_id: 'id foriegn:branches', warehouse_id: 'id foreign:warehouses', customer_id: 'id foreign:customerss', invoice_number: string, order_number: string, invoice_date: timestamp, item_id: 'id foreign:create_items', rate: string, quantity: string, discount_id: 'id foreign:discounts', tax_id: 'id foreign:taxes', amount: string }
    Sale: { customer_id: 'id foreign:customerss', product_id: 'id foreign:create_items', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', quantity: float, price: float, discount_id: 'id foreign:discounts', discount: float, sales_order_number: string, total_amount: flaot, amount_paid: float, balance_amount: float, payment_mode: 'id foreign:payment_modes' }
    CreditLimit: { name: string }
    CreditSale: { customer_id: 'id foreign:customerss', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', product_id: 'id foreign:create_items', credit_limit: 'id foreign:credit_limits', credit_amount: string, credit_balance: string }
    Customer: { customer_type_id: 'id foreign:customer_types', title_id: 'id foreign:titles', surname: string, firstname: string, middlename: string, phone_number: string, fullname: string }
    PaymentReceived: { customer_id: 'id foreign:customers', amount_received: string, bank_charges: float, payment_number: string, deposit_bank_id: 'id foreign:banks', payment_mode_id: 'id foreign:payment_modes', invoice_number: string }
    SalesReceipt: { customer_id: 'id foreign:customers', branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', product_id: 'id foreign:create_items', tax_id: 'id foreign:taxes', payment_mode_id: 'id foreign:payment_modes', discount_id: 'id foreign:discounts', quantity: string, rate: string, amount: string, receipt_date: timestamp, customer_note: string }
    PaymentVoucher: { product_id: 'id foreign:create_items', expense_date: timestamp, amount: string, description: string, branch_id: 'id foreign:branches', warehouse_id: 'id foreign:warehouses', tax_id: 'id foreign:taxes', vendor_id: 'id foreign:vendors', payment_mode_id: 'id foreign:payment_modes', expense_account_id: 'id foreign:expense_account_id' }
    VendorCredit: { vendor_id: 'id foreign:vendors', warehouse_id: 'id foreign:warehouses', credit_number: string, purchase_order_number: string, vendor_credit_date: date }
